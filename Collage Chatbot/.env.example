# Application Settings
ENVIRONMENT=development
DEBUG=True
APP_NAME="AIT College AI Assistant"
API_V1_STR="/api/v1"
SECRET_KEY="ait-secret-key-production-replace-in-real-env-must-be-32-chars-long"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Settings (Default to SQLite for zero-setup, PostgreSQL ready)
DATABASE_URL="sqlite:///./ait_assistant.db"
# Example PostgreSQL URL with pgvector:
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/ait_assistant"

# AI Provider Settings
GEMINI_API_KEY=""
AI_DEFAULT_PROVIDER="gemini"
AI_FALLBACK_PROVIDER="local"
OLLAMA_BASE_URL="http://localhost:11434"

# Official College Source Configuration
AIT_OFFICIAL_URL="https://www.aitindia.in"
AIT_COLLEGE_NAME="Ahmedabad Institute of Technology"
CRAWLER_USER_AGENT="AIT-Assistant-Bot/1.0 (+https://www.aitindia.in)"
CRAWLER_MAX_PAGES=50
CRAWLER_DELAY_SECONDS=1.0

# Voice Configuration
VOICE_STT_PROVIDER="faster_whisper"
VOICE_TTS_PROVIDER="piper"
VOICE_DEFAULT_LANGUAGE="en"
AUDIO_CACHE_DIR="./voice/audio_cache"

# Security & CORS
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"
ENABLE_RATE_LIMIT=True
RATE_LIMIT_PER_MINUTE=60
